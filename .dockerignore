# Keep the build context small and keep local state out of the image.
.git
.github
**/__pycache__
**/*.pyc
# Only the 4.5 MB scored-window dump is excluded. The measured JSON
# artifacts ARE build inputs: the console renders them, so the Space
# build needs them in context. Excluding the whole directory silently
# broke `docker build -f Dockerfile.space`.
artifacts/scored_test_windows.csv
ci_a
ci_b
dashboard.html
*.zip
*.png
.venv
venv
.env
*.log
