{
  "name": "sentinelai-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SentinelAI SOC console - React 19 + Vite + Tailwind v4 front end for the hybrid IDS",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-css.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "sync-data": "node scripts/sync-artifacts.mjs",
    "check:css": "node scripts/check-css.mjs"
  },
  "dependencies": {
    "animejs": "4.0.2",
    "clsx": "2.1.1",
    "motion": "12.23.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.3.1",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.1.11",
    "@types/node": "^22.0.0",
    "typescript": "5.9.2",
    "vite": "7.0.6",
    "@types/three": "^0.166.0"
  }
}
